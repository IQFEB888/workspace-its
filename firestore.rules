rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin check: safely inspect email claims
    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             (request.auth.token.email == "beccalli.fabio4@gmail.com" ||
              request.auth.token.email == "fabio.beccalli@itsrizzoli.it" ||
              request.auth.token.email.matches('.*beccalli.*') ||
              request.auth.token.email.matches('.*Beccalli.*'));
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    // Connection health check test collection
    match /test/{docId} {
      allow read, write: if true;
    }

    // Access Requests: any signed in user can create and view
    match /access_requests/{userId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Approved Users: managed by admin, readable by all authenticated users
    match /approved_users/{userId} {
      allow read, write: if isSignedIn();
      allow delete: if isAdmin();
    }

    // Root User Profile & Personal Workspace
    // Every user has exclusive full access to their own data tree (isOwner)
    match /users/{userId} {
      allow read, write, delete: if isOwner(userId) || isAdmin();

      // Subjects Subcollection
      match /subjects/{subjectId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      // Pages Subcollection
      match /pages/{pageId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      // Materials Subcollection
      match /materials/{materialId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      // Chat Sessions Subcollection
      match /chats/{subjectId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }

      // Settings Subcollection (e.g. Gemini Keys)
      match /settings/{settingId} {
        allow read, write, delete: if isOwner(userId) || isAdmin();
      }
    }

    // Shared Collaboration Rooms & Group Study
    match /shared_rooms/{roomId} {
      allow read, write: if isSignedIn();
      allow delete: if isSignedIn() && (resource.data.createdBy == request.auth.uid || isAdmin());

      // Shared Room Pages
      match /pages/{pageId} {
        allow read, write, delete: if isSignedIn();
      }

      // Shared Room Messages (Real-time Gemini & Student Chat)
      match /messages/{messageId} {
        allow read, write, delete: if isSignedIn();
      }

      // Shared Room Materials
      match /materials/{materialId} {
        allow read, write, delete: if isSignedIn();
      }

      // Presence / Active typing
      match /presence/{userId} {
        allow read: if isSignedIn();
        allow write, delete: if isSignedIn() && request.auth.uid == userId;
      }
    }

    // Fallback: deny all other paths
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
