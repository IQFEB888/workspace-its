rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin: ONLY beccalli.fabio4@gmail.com
    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             request.auth.token.email == "beccalli.fabio4@gmail.com";
    }

    // Approved User check: Admin or active status in approved_users collection
    function isApprovedUser(userId) {
      return isAdmin() ||
             (exists(/databases/$(database)/documents/approved_users/$(userId)) &&
              get(/databases/$(database)/documents/approved_users/$(userId)).data.status == 'active');
    }

    // Health check endpoint
    match /test/{document=**} {
      allow read, write: if true;
    }

    // Access Requests:
    // Any signed-in user can submit, check, and update their OWN request
    // Admin can list and manage all requests
    match /access_requests/{userId} {
      allow get, create, update: if isOwner(userId) || isAdmin();
      allow list, delete: if isAdmin();
    }

    // Approved Users directory:
    // Any signed-in user can check their OWN approval status
    // Admin can list, create, update, and delete all records
    match /approved_users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list, create, update, delete: if isAdmin();
    }

    // Personal Workspace & Subcollections:
    // Accessible only when approved by the admin (or if admin)
    match /users/{userId} {
      allow read, write: if (isOwner(userId) && isApprovedUser(userId)) || isAdmin();

      match /{allChildren=**} {
        allow read, write: if (isOwner(userId) && isApprovedUser(userId)) || isAdmin();
      }
    }

    // Shared Collaboration Rooms:
    // Only approved users or admin can access
    match /shared_rooms/{document=**} {
      allow read, write: if isSignedIn() && (isAdmin() || isApprovedUser(request.auth.uid));
    }
  }
}
