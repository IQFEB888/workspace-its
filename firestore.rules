rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Super Admin: ONLY beccalli.fabio4@gmail.com
    function isAdmin() {
      return isSignedIn() &&
             'email' in request.auth.token &&
             (request.auth.token.email == "beccalli.fabio4@gmail.com" ||
              request.auth.token.email.lower() == "beccalli.fabio4@gmail.com");
    }

    function isApprovedByUid(userId) {
      return exists(/databases/$(database)/documents/approved_users/$(userId)) &&
             get(/databases/$(database)/documents/approved_users/$(userId)).data.status == 'active';
    }

    function isRevokedByUid(userId) {
      return exists(/databases/$(database)/documents/approved_users/$(userId)) &&
             get(/databases/$(database)/documents/approved_users/$(userId)).data.status == 'revoked';
    }

    function isApprovedByEmail() {
      return 'email' in request.auth.token &&
             exists(/databases/$(database)/documents/approved_users/$(request.auth.token.email.lower())) &&
             get(/databases/$(database)/documents/approved_users/$(request.auth.token.email.lower())).data.status == 'active';
    }

    // Approved User check: Admin or active status in approved_users collection (by UID or email)
    function isApprovedUser(userId) {
      return isAdmin() || (!isRevokedByUid(userId) && (isApprovedByUid(userId) || isApprovedByEmail()));
    }

    // Health check endpoint
    match /test/{document=**} {
      allow read, write: if true;
    }

    // Access Requests:
    // Any signed-in user can submit, check, and update their OWN request
    // Admin can list and manage all requests
    match /access_requests/{userId} {
      allow get, create, update: if isOwner(userId) || isAdmin();
      allow list, delete: if isAdmin();
    }

    // Approved Users directory:
    // Any signed-in user can read individual approval docs to verify their status without error
    // Only Admin can list, create, update, and delete approval records
    match /approved_users/{userId} {
      allow get: if isSignedIn();
      allow list, create, update, delete: if isAdmin();
    }

    // Personal Workspace & Subcollections:
    // Accessible only when approved by the admin (or if admin)
    match /users/{userId} {
      allow read, write: if (isOwner(userId) && isApprovedUser(userId)) || isAdmin();

      match /{allChildren=**} {
        allow read, write: if (isOwner(userId) && isApprovedUser(userId)) || isAdmin();
      }
    }

    // Shared Collaboration Rooms:
    // Only approved users or admin can access
    match /shared_rooms/{document=**} {
      allow read, write: if isSignedIn() && (isAdmin() || isApprovedUser(request.auth.uid));
    }
  }
}
